{
  "entities": {
    "CloudTask": {
      "title": "CloudTask",
      "description": "User task or reminder synchronized with Firestore",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "titulo": {
          "type": "string",
          "description": "Task title"
        },
        "tipo": {
          "type": "string",
          "enum": ["tarea", "aviso"],
          "description": "Record type"
        },
        "relevancia": {
          "type": "string",
          "enum": ["alta", "media", "baja"],
          "description": "Task priority level"
        },
        "repeticion": {
          "type": "string",
          "enum": ["ninguna", "diaria", "semanal", "mensual", "anual"],
          "description": "Recurrence interval"
        },
        "fecha": {
          "type": "string",
          "description": "Scheduled date in YYYY-MM-DD format"
        },
        "hora": {
          "type": "string",
          "description": "Optional scheduled time in HH:mm format"
        },
        "notas": {
          "type": "string",
          "description": "Task notes and checklist items"
        },
        "completada": {
          "type": "boolean",
          "description": "Whether the task is completed"
        },
        "traspasado": {
          "type": "boolean",
          "description": "Whether exported to Google Calendar or Tasks"
        },
        "fechaCreacion": {
          "type": "string",
          "description": "Original ISO-8601 creation timestamp string"
        },
        "fechaCompletada": {
          "type": "string",
          "description": "Completion ISO-8601 timestamp string or empty"
        },
        "notaCierre": {
          "type": "string",
          "description": "Closing observation text"
        },
        "notificacionActiva": {
          "type": "boolean",
          "description": "Whether local notifications are enabled"
        },
        "minutosAntes": {
          "type": "integer",
          "description": "Reminder lead time in minutes"
        },
        "rachaDiaria": {
          "type": "integer",
          "description": "Current daily streak count"
        },
        "ultimaFechaCompletadaDiaria": {
          "type": "string",
          "description": "Last completion date for daily routine in YYYY-MM-DD or empty"
        },
        "categoria": {
          "type": "string",
          "description": "Optional category tag"
        },
        "diasSemana": {
          "type": "string",
          "description": "Comma-separated ISO weekday numbers (1..7) for daily tasks"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "titulo",
        "tipo",
        "relevancia",
        "repeticion",
        "fecha",
        "hora",
        "notas",
        "completada",
        "traspasado",
        "fechaCreacion",
        "fechaCompletada",
        "notaCierre",
        "notificacionActiva",
        "minutosAntes",
        "rachaDiaria",
        "ultimaFechaCompletadaDiaria",
        "categoria",
        "diasSemana",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudDailyNote": {
      "title": "CloudDailyNote",
      "description": "Fixed note attached to a calendar date",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "fecha": {
          "type": "string",
          "description": "Date key YYYY-MM-DD"
        },
        "texto": {
          "type": "string",
          "description": "Note content"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated"
        }
      },
      "required": ["userId", "fecha", "texto", "createdAt", "updatedAt"]
    },
    "CloudDiaryEntry": {
      "title": "CloudDiaryEntry",
      "description": "Diary manual observation or completed task log",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "fecha": {
          "type": "string",
          "description": "Date YYYY-MM-DD"
        },
        "hora": {
          "type": "string",
          "description": "Time HH:mm"
        },
        "fechaHoraISO": {
          "type": "string",
          "description": "ISO-8601 timestamp string"
        },
        "tipo": {
          "type": "string",
          "enum": ["manual", "completada"],
          "description": "Entry type"
        },
        "tareaId": {
          "type": "string",
          "description": "Linked task ID or empty"
        },
        "tituloTarea": {
          "type": "string",
          "description": "Linked task title"
        },
        "texto": {
          "type": "string",
          "description": "Diary entry content"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated"
        }
      },
      "required": [
        "userId",
        "fecha",
        "hora",
        "fechaHoraISO",
        "tipo",
        "tareaId",
        "tituloTarea",
        "texto",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/CloudTask" },
      "description": "User-scoped tasks and reminders synchronized across devices"
    },
    "/users/{userId}/daily_notes/{noteId}": {
      "schema": { "$ref": "#/entities/CloudDailyNote" },
      "description": "User-scoped calendar daily notes keyed by YYYY-MM-DD"
    },
    "/users/{userId}/diary_entries/{entryId}": {
      "schema": { "$ref": "#/entities/CloudDiaryEntry" },
      "description": "User-scoped diary observations and task completion logs"
    }
  }
}
