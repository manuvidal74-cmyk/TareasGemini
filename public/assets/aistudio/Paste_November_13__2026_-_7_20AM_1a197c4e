    // Formateo de notas con soporte de checklist interactivo (- [ ] y - [x])
    function formatearNotasConChecklist(tarea) {
      if (!tarea.notas) return '';
      const lineas = tarea.notas.split('\n');
      const tieneChecklist = lineas.some(l => /^\s*-\s*\[([ xX])\]\s*/.test(l));
      if (!tieneChecklist) {
        return `<div class="task-notes">${esc(tarea.notas)}</div>`;
      }

      const htmlLineas = lineas.map((linea, idx) => {
        const match = linea.match(/^\s*-\s*\[([ xX])\]\s*(.*)$/);
        if (match) {
          const marcado = match[1].toLowerCase() === 'x';
          const textoItem = match[2];
          return `
            <label class="checklist-row ${marcado ? 'checked' : ''}">
              <input type="checkbox" ${marcado ? 'checked' : ''} onchange="alternarItemChecklist('${tarea.id}', ${idx})">
              <span>${esc(textoItem)}</span>
            </label>
          `;
        }
        return linea ? `<div>${esc(linea)}</div>` : `<div style="height:6px;"></div>`;
      }).join('');

      return `<div class="task-notes" style="white-space:normal;">${htmlLineas}</div>`;
    }

    function alternarItemChecklist(tareaId, indiceLinea) {
      const t = tareas.find(x => x.id === tareaId);
      if (!t || !t.notas) return;
      const lineas = t.notas.split('\n');
      if (indiceLinea < 0 || indiceLinea >= lineas.length) return;

      const linea = lineas[indiceLinea];
      if (/^\s*-\s*\[\s\]\s*/.test(linea)) {
        lineas[indiceLinea] = linea.replace(/^(\s*-\s*)\[\s\]/, '$1[x]');
      } else if (/^\s*-\s*\[[xX]\]\s*/.test(linea)) {
        lineas[indiceLinea] = linea.replace(/^(\s*-\s*)\[[xX]\]/, '$1[ ]');
      }

      t.notas = lineas.join('\n');
      guardarTareas();
      renderizarTodo();
    }

    function posponerTareaRapido(id, dias) {
      const t = tareas.find(x => x.id === id);
      if (!t) return;
      const base = diferenciaDiasConHoy(t.fecha) < 0 ? obtenerFechaISOHoy() : t.fecha;
      t.fecha = sumarDiasAFechaISO(base, dias);
      guardarTareas();
      renderizarTodo();
      mostrarAviso(`⏭️ Pospuesta al ${formatearFechaES(t.fecha)}`);
    }

    function compartirTarea(id) {
      const t = tareas.find(x => x.id === id);
      if (!t) return;
      const tipoLabel = t.tipo === 'aviso' ? '🔔 Aviso' : '📌 Tarea';
      const lineas = [
        `${tipoLabel}: ${t.titulo}`,
        `📅 Fecha: ${formatearFechaES(t.fecha)}${t.hora ? ' a las ' + t.hora : ''}`
      ];
      if (t.notas) lineas.push(`📝 Notas:\n${t.notas}`);
      const textoCompartir = lineas.join('\n');

      if (navigator.share) {
        navigator.share({
          title: t.titulo,
          text: textoCompartir
        }).catch(() => {});
      } else {
        copiarTextoSeguro(textoCompartir);
        mostrarAviso('📤 Datos copiados al portapapeles para compartir');
      }
    }

    function crearHTMLTarjetaTarea(t, esProyeccionFutura, fechaProyectada) {
