      }

      const labelRel = t.relevancia === 'alta' ? '🔴 Alta' : (t.relevancia === 'media' ? '🟠 Media' : '🔵 Baja');
      const labelTipo = t.tipo === 'aviso' ? '🔔 Aviso' : '📌 Tarea';
      const labelRep = textoEtiquetaRepeticion(t.repeticion);
      const badgeTraspasado = t.traspasado ? `<span class="badge badge-traspasado" title="Traspasado a Google">📲 En Google</span>` : '';

      return `
        <div class="card task-card rel-${t.relevancia} ${t.completada ? 'done' : ''} ${esProyeccionFutura ? 'projected' : ''}">
          <div class="task-header">
            <h3 class="task-title">${esc(t.titulo)}</h3>
            <span class="badge badge-${t.relevancia}">${labelRel}</span>
          </div>
          <div class="task-meta">
            <span class="badge badge-tipo">${labelTipo}</span>
            ${badgeTraspasado}
            ${labelRep ? `<span class="badge badge-rep">${labelRep}</span>` : ''}
            <span>📅 ${formatearFechaES(fechaMostrar)}${t.hora ? ' ⏰ ' + esc(t.hora) : ''}</span>
            ${badgeFecha}
            ${esProyeccionFutura ? `<span class="badge badge-rep">Próxima repetición</span>` : ''}
          </div>
          ${t.notas ? formatearNotasConChecklist(t) : ''}
          ${t.completada && t.notaCierre ? `<div class="task-notes task-notes-cierre"><strong>Cierre:</strong> ${esc(t.notaCierre)}</div>` : ''}
          ${t.completada && t.fechaCompletada ? `<div style="font-size:11px; color:var(--green); font-weight:700; margin-bottom:4px;">✓ Realizada: ${formatearFechaHoraES(t.fechaCompletada)}</div>` : ''}
          <div class="task-actions">
            ${esProyeccionFutura ? `
              <button type="button" class="btn btn-outline btn-action" onclick="seleccionarDiaCalendario('${t.fecha}')">📅 Ir al turno actual</button>
              <button type="button" class="btn btn-outline btn-action" onclick="abrirModalEditar('${t.id}')">✏️ Editar repetición</button>
            ` : (!t.completada ? `
              <button type="button" class="btn btn-success btn-action" onclick="abrirModalCompletar('${t.id}')">✓ Completar</button>
              <button type="button" class="btn btn-outline btn-action" onclick="posponerTareaRapido('${t.id}', 1)" title="Posponer 1 día">⏭️ +1d</button>
              <button type="button" class="btn btn-outline btn-action" onclick="posponerTareaRapido('${t.id}', 7)" title="Posponer 1 semana">⏭️ +7d</button>
              <button type="button" class="btn btn-outline btn-action" onclick="traspasarAGoogleCalendar('${t.id}')" title="Abre Google Calendar con todos los campos ya rellenados">
                ${t.traspasado ? '✓ Cal' : '📅 Cal'}
              </button>
              <button type="button" class="btn btn-outline btn-action" onclick="traspasarAGoogleTasksWeb('${t.id}')" title="Copia los datos y abre Google Tasks">
                📋 Tasks
              </button>
              <button type="button" class="btn btn-outline btn-action" onclick="compartirTarea('${t.id}')" title="Compartir por WhatsApp / Email">📤</button>
              <button type="button" class="btn btn-outline btn-action" onclick="abrirModalEditar('${t.id}')" title="Editar">✏️</button>
              <button type="button" class="btn btn-outline btn-action" style="color:var(--red);" onclick="confirmarBorrarTarea('${t.id}')" title="Eliminar">🗑️</button>
            ` : `
              <button type="button" class="btn btn-outline btn-action" onclick="reabrirTarea('${t.id}')">↩️ Reabrir</button>
              <button type="button" class="btn btn-outline btn-action" onclick="compartirTarea('${t.id}')" title="Compartir">📤</button>
              <button type="button" class="btn btn-outline btn-action" onclick="abrirModalEditar('${t.id}')">✏️ Editar</button>
              <button type="button" class="btn btn-outline btn-action" style="color:var(--red);" onclick="confirmarBorrarTarea('${t.id}')">🗑️</button>
            `)}
          </div>
        </div>
      `;
