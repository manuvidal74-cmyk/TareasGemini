    // Aviso preventivo de copia de seguridad (>15 días)
    function renderizarAvisoBackup() {
      const panel = document.getElementById('panelAvisoBackup');
      if (!panel) return;
      if (tareas.length === 0 && diario.length === 0) {
        panel.style.display = 'none';
        return;
      }

      let mostrar = false;
      let textoAviso = '';
      if (!config.ultimoBackup) {
        if (tareas.length >= 3) {
          mostrar = true;
          textoAviso = 'Aún no has guardado ninguna copia de seguridad (.json).';
        }
      } else {
        const diffMs = Date.now() - new Date(config.ultimoBackup).getTime();
        const dias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        if (dias >= 15) {
          mostrar = true;
          textoAviso = `Han pasado ${dias} días desde tu última copia de seguridad.`;
        }
      }

      if (!mostrar) {
        panel.style.display = 'none';
        return;
      }

      panel.style.display = 'flex';
      panel.innerHTML = `
        <div style="font-size:12px; color:var(--text-main);">
