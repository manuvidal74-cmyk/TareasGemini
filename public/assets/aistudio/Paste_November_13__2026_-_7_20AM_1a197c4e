    function confirmarCompletarTarea() {
      if (!idTareaACompletar) return;
      const t = tareas.find(x => x.id === idTareaACompletar);
      if (t) {
        const ahoraISO = new Date().toISOString();
        const hoyStr = obtenerFechaISOHoy();
        const horaStr = obtenerHoraActualHHMM();
        const notaCierre = document.getElementById('notaCierreInput').value.trim();
        const esRepetitiva = t.repeticion && t.repeticion !== 'ninguna';
        const programarSiguiente = document.getElementById('chkProgramarSiguiente').checked;

        let detalleCierre = `Finalizada a las ${horaStr} (prevista para el ${formatearFechaES(t.fecha)}).`;
        if (notaCierre) detalleCierre += `\nObservación de cierre: ${notaCierre}`;
        else if (t.notas) detalleCierre += `\nDetalles: ${t.notas}`;

        diario.push({
          id: 'd-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
          fecha: hoyStr,
          hora: horaStr,
          fechaHoraISO: ahoraISO,
          tipo: 'completada',
          tareaId: t.id,
          tituloTarea: t.titulo,
          texto: detalleCierre
        });
        guardarDiario();

        if (esRepetitiva && programarSiguiente) {
          tareas.push({
            id: 'hist-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
            titulo: t.titulo,
            tipo: t.tipo,
            relevancia: t.relevancia,
            repeticion: t.repeticion,
            fecha: t.fecha,
            hora: t.hora,
            notas: t.notas,
            completada: true,
            traspasado: t.traspasado || false,
            fechaCreacion: t.fechaCreacion,
            fechaCompletada: ahoraISO,
            notaCierre: notaCierre
          });

          const nuevaFecha = calcularSiguienteFecha(t.fecha, t.repeticion);
          t.fecha = nuevaFecha;
          t.notaCierre = '';
          t.traspasado = false;
          guardarTareas();
          renderizarTodo();
          mostrarAviso(`✅ Registrada en Diario. Próxima: ${formatearFechaES(nuevaFecha)}`);
        } else {
          t.completada = true;
          t.fechaCompletada = ahoraISO;
          t.notaCierre = notaCierre;
          guardarTareas();
          renderizarTodo();
          mostrarAviso('✅ Tarea completada y registrada en el Diario');
        }
      }
      idTareaACompletar = null;
      document.getElementById('modalCompletar').classList.remove('open');
    }

