    // Copiar al portapapeles auxiliar
    function copiarTextoSeguro(texto) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(texto).catch(() => {});
      } else {
        const ta = document.createElement('textarea');
        ta.value = texto;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
      }
    }

    // Traspaso a Google Calendar
    function traspasarAGoogleCalendar(id) {
      const t = tareas.find(x => x.id === id);
      if (!t) return;

      t.traspasado = true;
      guardarTareas();
      renderizarTodo();

      const resumenTexto = `${t.titulo}${t.notas ? '\n' + t.notas : ''}`;
      copiarTextoSeguro(resumenTexto);

      const partes = t.fecha.split('-');
      const fechaCompacta = partes.join('');
      let fechasParam = `${fechaCompacta}/${fechaCompacta}`;
      if (t.hora) {
        const hParts = t.hora.split(':');
        const inicio = `${fechaCompacta}T${hParts[0]}${hParts[1]}00`;
        const finHora = String((parseInt(hParts[0], 10) + 1) % 24).padStart(2, '0');
        const fin = `${fechaCompacta}T${finHora}${hParts[1]}00`;
        fechasParam = `${inicio}/${fin}`;
      }
      let rruleParam = '';
      if (t.repeticion === 'semanal') rruleParam = '&recur=RRULE:FREQ=WEEKLY';
      else if (t.repeticion === 'mensual') rruleParam = '&recur=RRULE:FREQ=MONTHLY';
      else if (t.repeticion === 'anual') rruleParam = '&recur=RRULE:FREQ=YEARLY';

      const prefijoTipo = t.tipo === 'tarea' ? '[Tarea] ' : '[Aviso] ';
      const urlCalendar = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(prefijoTipo + t.titulo)}&details=${encodeURIComponent(t.notas || '')}&dates=${fechasParam}${rruleParam}`;
      window.open(urlCalendar, '_blank');
      mostrarAviso('📲 Abriendo Google Calendar con todos los campos listos');
    }

    // Traspaso a Google Tasks Web
    function traspasarAGoogleTasksWeb(id) {
      const t = tareas.find(x => x.id === id);
      if (!t) return;

      t.traspasado = true;
      guardarTareas();
      renderizarTodo();

      const textoCopiado = `${t.titulo}${t.fecha ? ' (' + formatearFechaES(t.fecha) + ')' : ''}${t.notas ? ' - ' + t.notas : ''}`;
      copiarTextoSeguro(textoCopiado);

      const urlTasks = `https://tasks.google.com/embed/?origin=https://calendar.google.com`;
      window.open(urlTasks, '_blank');
      mostrarAviso('📋 Texto copiado al portapapeles. Pégalo en Google Tasks');
    }

    // 3. Calendario Configurable
    const NOMBRES_MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    const DIAS_SEMANA_CORTO = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];

    function renderizarCalendario() {
      const cont = document.getElementById('contenedorRejillaCalendario');
      const titulo = document.getElementById('calTituloPeriodo');
      const panelDia = document.getElementById('panelDiaSeleccionado');

      if (vistaCalActual === 'agenda') {
        titulo.textContent = 'Agenda (Próximos 30 días)';
        panelDia.style.display = 'none';
        renderizarVistaAgenda(cont);
        return;
      }

      panelDia.style.display = 'block';

      if (vistaCalActual === 'mes') {
        const anio = fechaCursorCal.getFullYear();
        const mes = fechaCursorCal.getMonth();
        titulo.textContent = `${NOMBRES_MESES[mes]} ${anio}`;
        renderizarVistaMes(cont, anio, mes);
      } else {
        renderizarVistaSemana(cont, titulo);
      }
    }

    function obtenerItemsDeFecha(fechaStr) {
      const mostrarDone = config.mostrarRealizadasCal === 'si';
      const resultado = [];

      tareas.forEach(t => {
        if (!mostrarDone && t.completada) return;
        if (t.fecha === fechaStr) {
          resultado.push({ tarea: t, proyectada: false, fecha: fechaStr });
        } else if (coincideConRepeticionFutura(t, fechaStr)) {
          resultado.push({ tarea: t, proyectada: true, fecha: fechaStr });
        }
      });

      return resultado;
    }

    function renderizarVistaMes(cont, anio, mes) {
      const primerDiaMes = new Date(anio, mes, 1);
      const ultimoDiaMes = new Date(anio, mes + 1, 0);

      let offsetInicio = (primerDiaMes.getDay() + 6) % 7;
      const totalDiasMes = ultimoDiaMes.getDate();

      let html = `<div class="cal-grid-header">
        ${DIAS_SEMANA_CORTO.map(d => `<div>${d}</div>`).join('')}
      </div><div class="cal-grid">`;

      for (let i = 0; i < offsetInicio; i++) {
        html += `<div class="cal-day other-month"></div>`;
      }

      const hoyStr = obtenerFechaISOHoy();
      for (let dia = 1; dia <= totalDiasMes; dia++) {
        const fechaStr = `${anio}-${String(mes + 1).padStart(2, '0')}-${String(dia).padStart(2, '0')}`;
        const itemsDia = obtenerItemsDeFecha(fechaStr);
        html += construirCeldaDiaHTML(dia, fechaStr, hoyStr, itemsDia);
      }

      html += `</div>`;
      cont.innerHTML = html;
    }

    function renderizarVistaSemana(cont, tituloEl) {
      const cursor = new Date(fechaCursorCal);
      const diaSem = (cursor.getDay() + 6) % 7;
      const lunes = new Date(cursor);
      lunes.setDate(cursor.getDate() - diaSem);

      const domingo = new Date(lunes);
      domingo.setDate(lunes.getDate() + 6);

      tituloEl.textContent = `${lunes.getDate()} ${NOMBRES_MESES[lunes.getMonth()].slice(0,3)} - ${domingo.getDate()} ${NOMBRES_MESES[domingo.getMonth()].slice(0,3)}`;

      let html = `<div class="cal-grid-header">
        ${DIAS_SEMANA_CORTO.map(d => `<div>${d}</div>`).join('')}
      </div><div class="cal-grid">`;

      const hoyStr = obtenerFechaISOHoy();
      for (let i = 0; i < 7; i++) {
        const d = new Date(lunes);
        d.setDate(lunes.getDate() + i);
        const fStr = formatearDateAISO(d);
        const itemsDia = obtenerItemsDeFecha(fStr);
        html += construirCeldaDiaHTML(d.getDate(), fStr, hoyStr, itemsDia);
      }

      html += `</div>`;
      cont.innerHTML = html;
    }

    function construirCeldaDiaHTML(numeroDia, fechaStr, hoyStr, itemsDelDia) {
      const esHoy = fechaStr === hoyStr ? 'today' : '';
      const esSel = fechaStr === fechaSeleccionadaStr ? 'selected' : '';
      const tieneNota = (notasDia[fechaStr] && notasDia[fechaStr].trim().length > 0) ||
                        diario.some(d => d.fecha === fechaStr);

      const puntos = itemsDelDia.slice(0, 4).map(item => {
        const t = item.tarea;
        if (t.completada) return `<span class="dot dot-done"></span>`;
        if (item.proyectada) return `<span class="dot dot-rep"></span>`;
        return `<span class="dot dot-${t.relevancia}"></span>`;
      }).join('');

      return `
        <div class="cal-day ${esHoy} ${esSel}" onclick="seleccionarDiaCalendario('${fechaStr}')">
          <div class="cal-day-num">${numeroDia}</div>
          ${tieneNota ? `<div class="note-indicator">📝</div>` : ''}
          <div class="cal-dots">${puntos}</div>
        </div>
      `;
    }

    function renderizarVistaAgenda(cont) {
      const hoyDate = new Date();
      const entradasAgenda = [];

      for (let i = 0; i <= 30; i++) {
        const d = new Date(hoyDate);
        d.setDate(hoyDate.getDate() + i);
        const fStr = formatearDateAISO(d);
        const items = obtenerItemsDeFecha(fStr);
        items.forEach(it => entradasAgenda.push(it));
      }

      if (entradasAgenda.length === 0) {
        cont.innerHTML = `<div class="empty-state">No hay tareas programadas para los próximos 30 días.</div>`;
        return;
      }

      let html = '';
      let fechaActualGrupo = '';
      entradasAgenda.forEach(item => {
        if (item.fecha !== fechaActualGrupo) {
          fechaActualGrupo = item.fecha;
          html += `<div style="font-weight:700; color:var(--heading-color); margin:8px 0 4px 0; border-bottom:1px solid var(--border); padding-bottom:2px; font-size:13px;">
            📅 ${formatearFechaES(fechaActualGrupo)}
          </div>`;
        }
        html += crearHTMLTarjetaTarea(item.tarea, item.proyectada, item.fecha);
      });
      cont.innerHTML = html;
    }

    function seleccionarDiaCalendario(fechaStr) {
      fechaSeleccionadaStr = fechaStr;
      const partes = fechaStr.split('-').map(Number);
      fechaCursorCal = new Date(partes[0], partes[1] - 1, partes[2]);
      renderizarCalendario();
      renderizarDetalleDia(fechaStr);
    }

    function renderizarDetalleDia(fechaStr) {
      document.getElementById('tituloDiaSeleccionado').textContent = `📅 Día ${formatearFechaES(fechaStr)}`;
      document.getElementById('notaRapidaDia').value = notasDia[fechaStr] || '';

      const cont = document.getElementById('listaTareasDia');
      const itemsDelDia = obtenerItemsDeFecha(fechaStr).sort((a, b) => {
        if (a.tarea.completada !== b.tarea.completada) return a.tarea.completada ? 1 : -1;
        if (a.proyectada !== b.proyectada) return a.proyectada ? 1 : -1;
        return pesoRelevancia(b.tarea.relevancia) - pesoRelevancia(a.tarea.relevancia);
      });

      const obsDelDia = diario.filter(d => d.fecha === fechaStr);

      let html = '';
      if (itemsDelDia.length > 0) {
        html += itemsDelDia.map(it => crearHTMLTarjetaTarea(it.tarea, it.proyectada, it.fecha)).join('');
      }

      if (obsDelDia.length > 0) {
        html += `<div style="font-weight:700; color:var(--heading-color); margin:8px 0 4px 0; font-size:12.5px;">📖 Diario de este día (${obsDelDia.length}):</div>`;
        html += obsDelDia.map(d => {
          if (d.tipo === 'manual') {
            return `
              <div class="card" style="border-left:4px solid var(--accent); padding:6px 8px; margin-bottom:5px;">
                <div style="font-size:12px; white-space:pre-wrap; color:var(--text-main);">${esc(d.texto)}</div>
                <div style="display:flex; gap:4px; margin-top:4px;">
                  <button type="button" class="btn btn-outline btn-action" onclick="abrirModalAnadirObs('${d.fecha}')">➕ Añadir nota</button>
                  <button type="button" class="btn btn-outline btn-action" onclick="abrirModalEditarObs('${d.id}')">✏️ Editar todo</button>
                </div>
              </div>`;
          } else {
            return `
              <div class="diary-task-completed" style="border-radius:6px; margin-bottom:4px;">
                <div>
                  <strong>✅ ${esc(d.tituloTarea)}</strong>
                  <div style="font-size:11.5px; margin-top:2px; white-space:pre-wrap;">${esc(d.texto)}</div>
                </div>
                <span class="diary-time-badge">${esc(d.hora)}</span>
              </div>`;
          }
        }).join('');
      }

      if (!html) {
        cont.innerHTML = `<div class="empty-state" style="padding:10px;">Sin tareas ni observaciones en este día.</div>`;
      } else {
        cont.innerHTML = html;
      }
    }

    // 4. Agenda Diario (unificado con notas fijas del calendario)
    function renderizarDiario() {
      const cont = document.getElementById('listaDiario');
      const fechaFiltro = document.getElementById('filtroFechaDiario').value;
      const texto = document.getElementById('buscarDiario').value.trim().toLowerCase();

      const fechasSet = new Set(diario.map(d => d.fecha));
      Object.keys(notasDia).forEach(f => {
        if (notasDia[f] && notasDia[f].trim()) fechasSet.add(f);
      });

      let listaFechas = Array.from(fechasSet).sort().reverse();

      if (fechaFiltro) {
        listaFechas = listaFechas.filter(f => f === fechaFiltro);
      }

      if (listaFechas.length === 0) {
        cont.innerHTML = `<div class="card empty-state">No hay registros en el Diario con los filtros actuales.</div>`;
        return;
      }

      let html = '';
      listaFechas.forEach(fecha => {
        let itemsFecha = diario.filter(d => d.fecha === fecha);
        let notaCal = (notasDia[fecha] && notasDia[fecha].trim()) ? notasDia[fecha].trim() : '';

        if (texto) {
          itemsFecha = itemsFecha.filter(d =>
            (d.texto && d.texto.toLowerCase().includes(texto)) ||
            (d.tituloTarea && d.tituloTarea.toLowerCase().includes(texto))
          );
          const coincideNotaCal = notaCal.toLowerCase().includes(texto);
          if (!coincideNotaCal) notaCal = '';
          if (itemsFecha.length === 0 && !notaCal) return;
        }

        const obsManual = itemsFecha.find(d => d.tipo === 'manual');
        const completadas = itemsFecha.filter(d => d.tipo === 'completada').sort((a, b) => (b.hora || '').localeCompare(a.hora || ''));

        html += `
          <div class="diary-day-card">
            <div class="diary-day-header-bar">
              <span>📅 ${formatearFechaES(fecha)}</span>
              <button type="button" class="btn btn-outline btn-action" onclick="abrirModalAnadirObs('${fecha}')">➕ Añadir nota</button>
            </div>
        `;

        if (notaCal) {
          html += `
            <div class="diary-cal-note-block">
              <div style="font-weight:700; font-size:11px; color:var(--accent); margin-bottom:2px;">📝 Nota fija del calendario:</div>
              <div style="white-space:pre-wrap;">${esc(notaCal)}</div>
            </div>
          `;
        }

        if (obsManual) {
          html += `
            <div class="diary-obs-block">
              <div class="diary-obs-content">${esc(obsManual.texto)}</div>
              <div style="display:flex; gap:4px; justify-content:flex-end;">
                <button type="button" class="btn btn-outline btn-action" onclick="abrirModalAnadirObs('${fecha}')">➕ Añadir nota</button>
                <button type="button" class="btn btn-outline btn-action" onclick="abrirModalEditarObs('${obsManual.id}')">✏️ Editar todo</button>
                <button type="button" class="btn btn-outline btn-action" style="color:var(--red);" onclick="confirmarBorrarDiario('${obsManual.id}')">🗑️</button>
              </div>
            </div>
          `;
        }

        if (completadas.length > 0) {
          html += `<div class="diary-completed-title">TAREAS COMPLETADAS ESTE DÍA (${completadas.length}):</div>`;
          completadas.forEach(c => {
            html += `
              <div class="diary-task-completed">
                <div style="flex:1; min-width:0;">
                  <div style="font-weight:700; font-size:12.5px;">✓ ${esc(c.tituloTarea)}</div>
                  <div style="font-size:11.5px; white-space:pre-wrap; margin-top:1px;">${esc(c.texto)}</div>
                </div>
                <div style="display:flex; flex-direction:column; align-items:flex-end; gap:3px;">
                  <span class="diary-time-badge">${esc(c.hora)}</span>
                  <button type="button" class="btn btn-outline btn-action" style="min-height:30px; padding:2px 6px; font-size:11px;" onclick="abrirModalEditarObs('${c.id}')">✏️</button>
                </div>
              </div>
            `;
          });
        }

        html += `</div>`;
      });

      if (!html) {
        cont.innerHTML = `<div class="card empty-state">No se encontraron observaciones ni tareas que coincidan con la búsqueda.</div>`;
      } else {
        cont.innerHTML = html;
      }
    }

    function abrirModalAnadirObs(fechaPredefinida) {
      const f = fechaPredefinida || obtenerFechaISOHoy();
      document.getElementById('inputFechaAnadirObs').value = f;
      document.getElementById('inputTextoNuevaObs').value = '';

      const existente = diario.find(d => d.fecha === f && d.tipo === 'manual');
      const boxPrevio = document.getElementById('previoObservacionesDia');
      if (existente && existente.texto.trim()) {
        boxPrevio.style.display = 'block';
        boxPrevio.innerHTML = `<strong>Observaciones ya anotadas este día:</strong><br>${esc(existente.texto)}`;
      } else {
        boxPrevio.style.display = 'none';
      }

      document.getElementById('modalAnadirObsDiario').classList.add('open');
    }

    function abrirModalEditarObs(id) {
      const reg = diario.find(d => d.id === id);
      if (!reg) return;
      document.getElementById('editObsId').value = reg.id;
      document.getElementById('editObsFecha').value = reg.fecha;
      document.getElementById('editObsTexto').value = reg.texto || '';
      document.getElementById('modalEditarObsDiario').classList.add('open');
    }

    function confirmarBorrarDiario(id) {
      pedirConfirmacion('Eliminar apunte del Diario', '¿Seguro que quieres eliminar esta anotación del Diario?', () => {
        diario = diario.filter(x => x.id !== id);
        guardarDiario();
        renderizarTodo();
        mostrarAviso('🗑️ Apunte del diario eliminado');
      });
    }

    // 5. Histórico
    function renderizarHistorico() {
      const realizadas = tareas.filter(t => t.completada);
      const pendientesCount = tareas.filter(t => !t.completada).length;

      const hoy = new Date();
      const mesActualPrefijo = `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}`;
      const hechasEsteMes = realizadas.filter(t => {
        if (t.fechaCompletada) return t.fechaCompletada.startsWith(mesActualPrefijo);
        return t.fecha && t.fecha.startsWith(mesActualPrefijo);
      }).length;

      document.getElementById('statTotalRealizadas').textContent = realizadas.length;
      document.getElementById('statEsteMes').textContent = hechasEsteMes;
      document.getElementById('statPendientesCount').textContent = pendientesCount;

      const texto = document.getElementById('buscarHistorico').value.trim().toLowerCase();
      const relFiltro = document.getElementById('filtroRelHistorico').value;

      let filtradas = realizadas.slice();
      if (relFiltro !== 'todas') filtradas = filtradas.filter(t => t.relevancia === relFiltro);
      if (texto) {
        filtradas = filtradas.filter(t =>
          (t.titulo && t.titulo.toLowerCase().includes(texto)) ||
          (t.notas && t.notas.toLowerCase().includes(texto)) ||
          (t.notaCierre && t.notaCierre.toLowerCase().includes(texto))
        );
      }

      filtradas.sort((a, b) => {
        const fA = a.fechaCompletada || a.fecha || '';
        const fB = b.fechaCompletada || b.fecha || '';
        return fB.localeCompare(fA);
      });

      const contadorHist = document.getElementById('contadorHistorico');
      if (contadorHist) {
        contadorHist.textContent = `Mostrando ${filtradas.length} de ${realizadas.length} realizadas`;
      }

      const cont = document.getElementById('listaHistorico');
      if (filtradas.length === 0) {
        cont.innerHTML = `<div class="card empty-state">No hay tareas realizadas con estos filtros.</div>`;
        return;
      }

      cont.innerHTML = filtradas.map(t => crearHTMLTarjetaTarea(t)).join('');
    }

    // Gestión de tareas
    function abrirModalNuevaTarea(fechaPredefinida) {
      document.getElementById('tituloModalTarea').textContent = 'Nueva tarea o aviso';
      document.getElementById('tareaId').value = '';
      document.getElementById('tareaTitulo').value = '';
      document.getElementById('tareaTipo').value = 'tarea';
      document.getElementById('tareaRelevancia').value = 'media';
