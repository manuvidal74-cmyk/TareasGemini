    function ejecutarExportacionExcel(e) {
      e.preventDefault();
      const selectCarpeta = document.getElementById('selectCarpetaExcel').value;
      let carpetaDestino = selectCarpeta;
      if (selectCarpeta === '__custom__') {
        carpetaDestino = document.getElementById('inputCarpetaPersonalizada').value.trim() || 'tareas';
      }

      config.carpetaExcel = carpetaDestino;
      guardarConfig();

      let nombreArchivo = document.getElementById('inputNombreArchivoExcel').value.trim() || `informe_tareas_diario_${obtenerFechaISOHoy()}.xls`;
      if (!/\.(xls|xlsx)$/i.test(nombreArchivo)) {
        nombreArchivo += '.xls';
      }

      const cabecerasTareas = [
        'ID', 'Nombre', 'Tipo', 'Descripción', 'Fecha creación',
        'Estado', 'Traspasado a Google', 'Fecha de finalización',
        'Relevancia', 'Fecha prevista'
      ];

      const filasTareas = tareas.length ? tareas.map(t => [
        t.id || '',
        t.titulo || '',
        t.tipo === 'aviso' ? 'Aviso' : 'Tarea',
        t.notas || '',
        t.fechaCreacion ? formatearFechaHoraES(t.fechaCreacion) : '',
        t.completada ? 'Completada' : 'Pendiente',
        t.traspasado ? 'Sí' : 'No',
        t.fechaCompletada ? formatearFechaHoraES(t.fechaCompletada) : '',
        (t.relevancia || 'media').toUpperCase(),
        formatearFechaES(t.fecha) + (t.hora ? ' ' + t.hora : '')
      ]) : [['', 'Sin tareas registradas', '', '', '', '', '', '', '', '']];

      const diarioOrdenado = diario.slice().sort((a, b) => {
        const fA = (a.fecha || '') + ' ' + (a.hora || '');
        const fB = (b.fecha || '') + ' ' + (b.hora || '');
        return fB.localeCompare(fA);
      });

      const cabecerasDiario = [
        'Fecha', 'Hora', 'Tipo de Registro', 'Tareas vinculadas', 'Observaciones/Notas'
      ];

      const filasDiario = diarioOrdenado.length ? diarioOrdenado.map(d => [
        formatearFechaES(d.fecha),
        d.hora || '',
        d.tipo === 'completada' ? 'Tarea completada' : 'Observación manual',
        d.tituloTarea || '',
        d.texto || ''
      ]) : [['', '', 'Sin observaciones en el diario', '', '']];

      const xmlExcel = generarLibroExcelXML([
        {
          nombre: 'Tareas',
          cabeceras: cabecerasTareas,
          filas: filasTareas,
          anchos: [110, 200, 75, 230, 115, 90, 110, 115, 80, 115]
        },
        {
          nombre: 'Agenda y Diario',
          cabeceras: cabecerasDiario,
          filas: filasDiario,
          anchos: [90, 65, 130, 200, 320]
        }
      ]);

      const res = guardarArchivo(nombreArchivo, xmlExcel, carpetaDestino);
      document.getElementById('modalExportarExcel').classList.remove('open');
      mostrarAviso(`📊 ${res}`);
    }

