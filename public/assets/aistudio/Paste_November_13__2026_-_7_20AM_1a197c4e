        document.getElementById('filtroFechaDiario').value = '';
        document.getElementById('buscarDiario').value = '';
        renderizarDiario();
      });

      // Calendario
      document.getElementById('btnVistaMes').addEventListener('click', () => {
        vistaCalActual = 'mes';
        actualizarBotonesVistaCalendario();
        renderizarCalendario();
      });
      document.getElementById('btnVistaSemana').addEventListener('click', () => {
        vistaCalActual = 'semana';
        actualizarBotonesVistaCalendario();
        renderizarCalendario();
      });
      document.getElementById('btnVistaAgenda').addEventListener('click', () => {
        vistaCalActual = 'agenda';
        actualizarBotonesVistaCalendario();
        renderizarCalendario();
      });

      document.getElementById('btnCalPrev').addEventListener('click', () => {
        if (vistaCalActual === 'mes') fechaCursorCal.setMonth(fechaCursorCal.getMonth() - 1);
        else fechaCursorCal.setDate(fechaCursorCal.getDate() - 7);
        renderizarCalendario();
      });

      document.getElementById('btnCalNext').addEventListener('click', () => {
        if (vistaCalActual === 'mes') fechaCursorCal.setMonth(fechaCursorCal.getMonth() + 1);
        else fechaCursorCal.setDate(fechaCursorCal.getDate() + 7);
        renderizarCalendario();
      });

      document.getElementById('btnCalHoy').addEventListener('click', () => {
        fechaCursorCal = new Date();
        fechaSeleccionadaStr = obtenerFechaISOHoy();
        renderizarCalendario();
        renderizarDetalleDia(fechaSeleccionadaStr);
      });

      document.getElementById('notaRapidaDia').addEventListener('input', (e) => {
        const val = e.target.value;
        if (val.trim()) notasDia[fechaSeleccionadaStr] = val;
        else delete notasDia[fechaSeleccionadaStr];
        guardarNotasDia();
        renderizarCalendario();
      });

      document.getElementById('buscarHistorico').addEventListener('input', renderizarHistorico);
      document.getElementById('filtroRelHistorico').addEventListener('change', renderizarHistorico);

      document.getElementById('btnLimpiarHistorico').addEventListener('click', () => {
        const realizadasCount = tareas.filter(t => t.completada).length;
        if (realizadasCount === 0) {
          mostrarAviso('El histórico ya está vacío');
          return;
        }
        pedirConfirmacion('Vaciar histórico', `¿Seguro que quieres borrar las ${realizadasCount} tareas realizadas? Las tareas pendientes y las observaciones del Diario no se eliminarán.`, () => {
          tareas = tareas.filter(t => !t.completada);
          guardarTareas();
          renderizarTodo();
          mostrarAviso('🗑️ Histórico vaciado');
        });
      });

      // Ajustes
      document.getElementById('cfgTema').addEventListener('change', (e) => {
        config.tema = e.target.value;
        aplicarTemaVisual(config.tema);
        guardarConfig();
        mostrarAviso('Tema actualizado');
      });

      document.getElementById('cfgVistaDefecto').addEventListener('change', (e) => {
        config.vistaDefecto = e.target.value;
        vistaCalActual = config.vistaDefecto;
        guardarConfig();
        actualizarBotonesVistaCalendario();
        renderizarCalendario();
        mostrarAviso('Preferencia guardada');
      });

      document.getElementById('cfgDiasPreaviso').addEventListener('change', (e) => {
        config.diasPreaviso = parseInt(e.target.value, 10) || 3;
        guardarConfig();
        renderizarAvisosUrgentes();
        mostrarAviso('Preferencia guardada');
      });

      document.getElementById('cfgMostrarRealizadasCal').addEventListener('change', (e) => {
        config.mostrarRealizadasCal = e.target.value;
        guardarConfig();
        renderizarCalendario();
        mostrarAviso('Preferencia guardada');
      });

      // Backup JSON
      document.getElementById('btnExportarBackup').addEventListener('click', exportarCopiaSeguridadJSON);

      document.getElementById('inputRestaurarBackup').addEventListener('change', (e) => {
        const archivo = e.target.files && e.target.files[0];
        if (!archivo) return;
        const lector = new FileReader();
        lector.onload = (ev) => {
          try {
            const datos = JSON.parse(ev.target.result);
            if (!Array.isArray(datos.tareas)) {
              mostrarAviso('❌ El archivo no tiene un formato válido');
              return;
            }
            pedirConfirmacion('Restaurar copia de seguridad', `Se cargarán ${datos.tareas.length} tareas, ${(datos.diario || []).length} apuntes del diario y las notas del calendario, reemplazando los datos actuales. ¿Deseas continuar?`, () => {
              tareas = datos.tareas.map(t => Object.assign({ repeticion: 'ninguna', traspasado: false }, t));
              notasDia = datos.notasDia || {};
              diario = Array.isArray(datos.diario) ? datos.diario.filter(d => d.tipo !== 'creacion') : [];
              if (datos.config) config = Object.assign(config, datos.config);
              aplicarTemaVisual(config.tema || 'sistema');
              guardarTareas();
              guardarNotasDia();
              guardarDiario();
              guardarConfig();
              sincronizarSelectoresAjustes();
              renderizarTodo();
              mostrarAviso('✅ Copia de seguridad restaurada con éxito');
            });
          } catch (err) {
            mostrarAviso('❌ Error al procesar el archivo JSON');
          }
        };
        lector.readAsText(archivo);
        e.target.value = '';
      });

      document.getElementById('btnCargarEjemplos').addEventListener('click', () => {
        cargarEjemplosIniciales(false);
      });
    });
  </script>
</body>
</html>
