      let b64;
      if (typeof contenido === 'string') b64 = btoa(unescape(encodeURIComponent(contenido)));
      else { let s = ''; for (let i = 0; i < contenido.length; i += 0x8000) s += String.fromCharCode.apply(null, contenido.subarray(i, i + 0x8000)); b64 = btoa(s); }
      if (window.AndroidApp && window.AndroidApp.saveFile) {
        const r = String(window.AndroidApp.saveFile(nombre, b64, carpeta || document.title));
        return r.startsWith('ok:') ? 'Guardado en ' + r.slice(3) : 'No se pudo guardar: ' + r;
      }
      const a = document.createElement('a');
      a.href = 'data:application/octet-stream;base64,' + b64; a.download = nombre; a.click();
      return 'Descargado';
    }

    // Gestión del Tema Visual
    function aplicarTemaVisual(tema) {
      const root = document.documentElement;
      if (tema === 'claro') root.setAttribute('data-theme', 'claro');
      else if (tema === 'oscuro') root.setAttribute('data-theme', 'oscuro');
      else root.removeAttribute('data-theme');
    }

    // Utilidades de fechas
    function formatearDateAISO(d) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${day}`;
    }

    function obtenerFechaISOHoy() {
      return formatearDateAISO(new Date());
    }

    function obtenerHoraActualHHMM() {
      const d = new Date();
      return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    }

    function formatearFechaES(isoDate) {
      if (!isoDate) return '';
      const partes = isoDate.split('-');
      if (partes.length !== 3) return isoDate;
      return `${partes[2]}/${partes[1]}/${partes[0]}`;
    }

    function formatearFechaHoraES(isoString) {
      if (!isoString) return '';
      try {
        const d = new Date(isoString);
        const dia = String(d.getDate()).padStart(2, '0');
        const mes = String(d.getMonth() + 1).padStart(2, '0');
        const anio = d.getFullYear();
        const hora = String(d.getHours()).padStart(2, '0');
        const min = String(d.getMinutes()).padStart(2, '0');
        return `${dia}/${mes}/${anio} ${hora}:${min}`;
      } catch (e) {
        return isoString;
      }
    }

    function diferenciaDiasConHoy(isoDate) {
      const hoyStr = obtenerFechaISOHoy();
      const dHoy = new Date(hoyStr + 'T00:00:00');
      const dObj = new Date(isoDate + 'T00:00:00');
      return Math.round((dObj - dHoy) / (1000 * 60 * 60 * 24));
    }

    function sumarDiasAFechaISO(isoDate, dias) {
      const base = isoDate || obtenerFechaISOHoy();
      const partes = base.split('-').map(Number);
      const d = new Date(partes[0], partes[1] - 1, partes[2]);
      d.setDate(d.getDate() + dias);
      return formatearDateAISO(d);
    }

    // Repeticiones
    function sumarPasosRepeticion(isoDateBase, repeticion, pasos) {
      if (!isoDateBase || !repeticion || repeticion === 'ninguna') return isoDateBase;
      const partes = isoDateBase.split('-').map(Number);
      const yBase = partes[0];
      const mBase = partes[1] - 1;
      const dBase = partes[2];

      if (repeticion === 'semanal') {
        const d = new Date(yBase, mBase, dBase);
        d.setDate(d.getDate() + (7 * pasos));
        return formatearDateAISO(d);
      }

      if (repeticion === 'mensual') {
        const totalMeses = mBase + pasos;
        const nuevoAnio = yBase + Math.floor(totalMeses / 12);
        const nuevoMes = ((totalMeses % 12) + 12) % 12;
        const maxDiasMes = new Date(nuevoAnio, nuevoMes + 1, 0).getDate();
        const diaFinal = Math.min(dBase, maxDiasMes);
        return formatearDateAISO(new Date(nuevoAnio, nuevoMes, diaFinal));
      }

      if (repeticion === 'anual') {
        const nuevoAnio = yBase + pasos;
        const maxDiasMes = new Date(nuevoAnio, mBase + 1, 0).getDate();
        const diaFinal = Math.min(dBase, maxDiasMes);
        return formatearDateAISO(new Date(nuevoAnio, mBase, diaFinal));
      }

      return isoDateBase;
    }

    function calcularSiguienteFecha(isoDateActual, repeticion) {
      return sumarPasosRepeticion(isoDateActual, repeticion, 1);
    }

    function coincideConRepeticionFutura(tarea, fechaObjetivoStr) {
      if (!tarea || tarea.completada) return false;
      const rep = tarea.repeticion || 'ninguna';
      if (rep === 'ninguna' || !tarea.fecha) return false;
      if (fechaObjetivoStr <= tarea.fecha) return false;

      if (rep === 'semanal') {
        const dBase = new Date(tarea.fecha + 'T00:00:00');
        const dObj = new Date(fechaObjetivoStr + 'T00:00:00');
        const diffDias = Math.round((dObj - dBase) / (1000 * 60 * 60 * 24));
        return diffDias > 0 && diffDias % 7 === 0;
      }

      if (rep === 'mensual') {
        for (let k = 1; k <= 60; k++) {
          const f = sumarPasosRepeticion(tarea.fecha, 'mensual', k);
          if (f === fechaObjetivoStr) return true;
          if (f > fechaObjetivoStr) return false;
        }
        return false;
      }

      if (rep === 'anual') {
        for (let k = 1; k <= 25; k++) {
          const f = sumarPasosRepeticion(tarea.fecha, 'anual', k);
          if (f === fechaObjetivoStr) return true;
          if (f > fechaObjetivoStr) return false;
        }
        return false;
      }

      return false;
    }

    function textoEtiquetaRepeticion(rep) {
      if (rep === 'semanal') return '🔁 Semanal';
      if (rep === 'mensual') return '🔁 Mensual';
      if (rep === 'anual') return '🔁 Anual';
      return '';
    }

