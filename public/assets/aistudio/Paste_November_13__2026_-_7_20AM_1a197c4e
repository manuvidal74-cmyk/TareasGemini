    function renderizarPendientes() {
      actualizarEstadoBotonFiltros();

      const cont = document.getElementById('listaPendientes');
      const relFiltro = document.getElementById('filtroRelevancia').value;
      const tipoFiltro = document.getElementById('filtroTipo').value;
      const repFiltro = document.getElementById('filtroRepeticion').value;
      const texto = document.getElementById('buscarPendientes').value.trim().toLowerCase();
      const orden = document.getElementById('ordenPendientes').value;

      const todasPendientes = tareas.filter(t => !t.completada);
      let lista = todasPendientes.slice();

      if (relFiltro !== 'todas') lista = lista.filter(t => t.relevancia === relFiltro);
      if (tipoFiltro !== 'todos') lista = lista.filter(t => t.tipo === tipoFiltro);
      if (repFiltro !== 'todas') {
        if (repFiltro === 'repetitivas') lista = lista.filter(t => t.repeticion && t.repeticion !== 'ninguna');
        else lista = lista.filter(t => (t.repeticion || 'ninguna') === repFiltro);
      }
      if (texto) {
        lista = lista.filter(t =>
          (t.titulo && t.titulo.toLowerCase().includes(texto)) ||
          (t.notas && t.notas.toLowerCase().includes(texto))
        );
      }

      lista.sort((a, b) => {
        if (orden === 'relevancia') {
          const diffRel = pesoRelevancia(b.relevancia) - pesoRelevancia(a.relevancia);
          if (diffRel !== 0) return diffRel;
        }
        const fA = (a.fecha || '9999-99-99') + (a.hora || '23:59');
        const fB = (b.fecha || '9999-99-99') + (b.hora || '23:59');
        const diffFecha = fA.localeCompare(fB);
        if (diffFecha !== 0) return diffFecha;
        return (a.titulo || '').localeCompare(b.titulo || '', 'es', { sensitivity: 'base' });
      });

      const contadorEl = document.getElementById('contadorPendientes');
      if (contadorEl) {
        contadorEl.textContent = `Mostrando ${lista.length} de ${todasPendientes.length} pendientes`;
      }

      if (lista.length === 0) {
        cont.innerHTML = `<div class="card empty-state">No hay tareas pendientes con estos filtros.</div>`;
        return;
      }

      cont.innerHTML = lista.map(t => crearHTMLTarjetaTarea(t)).join('');
