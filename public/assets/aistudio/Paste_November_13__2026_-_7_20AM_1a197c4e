      const panel = document.getElementById('panelAvisosUrgentes');
      const diasAviso = parseInt(config.diasPreaviso, 10) || 3;
      const pendientes = tareas.filter(t => !t.completada);

      const alertas = pendientes.filter(t => {
        const diff = diferenciaDiasConHoy(t.fecha);
        return diff <= diasAviso;
      }).sort((a, b) => a.fecha.localeCompare(b.fecha));

      if (alertas.length === 0) {
        panel.className = 'card alert-banner ok';
        panel.innerHTML = `
          <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:18px;">✅</span>
            <div>
              <strong style="font-size:13px; color:var(--text-main);">Todo al día</strong>
              <div style="font-size:11.5px; color:var(--text-muted);">Sin tareas vencidas ni avisos próximos (${diasAviso}d).</div>
            </div>
          </div>
        `;
        return;
      }

      panel.className = 'card alert-banner';
      let html = `<div style="font-size:13.5px; font-weight:700; color:var(--red); margin-bottom:4px;">
        🔔 ${alertas.length} ${alertas.length === 1 ? 'aviso prioritario' : 'avisos prioritarios'}
      </div>`;

      alertas.slice(0, 4).forEach(t => {
        const diff = diferenciaDiasConHoy(t.fecha);
        let etiquetaEstado = '';
        if (diff < 0) etiquetaEstado = `<span class="badge badge-vencida">Vencida (${Math.abs(diff)}d)</span>`;
        else if (diff === 0) etiquetaEstado = `<span class="badge badge-hoy">Hoy</span>`;
        else etiquetaEstado = `<span class="badge badge-media">En ${diff}d</span>`;

        html += `
          <div class="alert-item">
            <div style="flex:1; min-width:0;">
              <div style="font-weight:700; font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:var(--text-main);">${esc(t.titulo)}</div>
              <div style="font-size:11px; color:var(--text-muted);">
                ${etiquetaEstado} ${t.traspasado ? '<span class="badge badge-traspasado">📲 En Google</span>' : ''} · ${formatearFechaES(t.fecha)} ${t.hora ? t.hora : ''}
              </div>
            </div>
            <div style="display:flex; gap:4px; flex-shrink:0;">
              <button type="button" class="btn btn-outline btn-action" onclick="posponerTareaRapido('${t.id}', 1)" title="Posponer 1 día">+1d</button>
